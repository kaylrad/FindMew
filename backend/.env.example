# Copy to backend/.env. Never expose the service role to the frontend.
PORT=3001
NODE_ENV=development
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# true: isolated local JSON demo. false: require the Supabase values below.
DEMO_MODE=true
SUPABASE_URL=https://qugxmmzhswomnxtlncjj.supabase.co
# Use the new key pair, or the legacy pair below. Keep all secret keys backend-only.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cat-photos
COLLECTION_REWARD=10
FEEDING_BONUS_REWARD=5
# Required only for opt-in production demo; use a long random secret.
DEMO_TOKEN_SECRET=
# Only trust the exact number of reverse proxies in front of Express.
TRUST_PROXY_HOPS=0
API_RATE_LIMIT=180
UPLOAD_RATE_LIMIT=12
MAX_CONCURRENT_UPLOADS=2
# Optional locally; Vercel Cron requires a random value with at least 32 characters.
CRON_SECRET=
